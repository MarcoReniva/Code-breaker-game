using System;
using System.Collections.Generic;
using System.Linq;
using System.Runtime.ExceptionServices;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApp8
{
    internal class Program
    {
        static string numgenerator()
        {
            Random rand = new Random();
            string secret = "";

            for (int i = 0; i < 3; i++)
            {
                secret += rand.Next(10);
            }

            return secret;
        }

        static void Number()
        {

            string secret = numgenerator();
            int attemp = 0;
            int maxattemp = 6;
            bool userwon = false;
            while (attemp < maxattemp && !userwon)
            {
                Console.WriteLine("Guess the Number it has 3 digits");
                Console.Write("Enter Guess: ");
                string num = Console.ReadLine();

                if (num.Length != 3)
                {
                    Console.Clear();
                    Console.WriteLine("Enter Exactly 3 digits only");
                    continue;
                }

                attemp++;

                int correctpos = 0;
                int wrongpos = 0;
                for (int i = 0; i < 3; i++)
                {
                    if (num[i] == secret[i])
                    {
                        correctpos++;
                    }
                    else if (secret.Contains(num[i]))
                    {
                        wrongpos++;
                    }
                }
                Console.Clear();
                Console.WriteLine($"Guessed Number: {num}");
                Console.WriteLine($"Correct Position: {correctpos}");
                Console.WriteLine($"Wrong Position: {wrongpos}");
                Console.WriteLine($"Number of Attempts: {attemp}/{maxattemp}");


                if (num == secret)
                {
                    userwon = true;
                    Console.ForegroundColor = ConsoleColor.Green;
                    Console.WriteLine("                  Results                    ");
                    Console.WriteLine("============================================");
                    Console.WriteLine("You Guessed the right number!");
                    Console.WriteLine($"Correct Number: {secret}");
                    Console.WriteLine($"Number Of Attempts: {attemp}");
                    Console.WriteLine("============================================");
                    Console.ResetColor();
                }
                else if (attemp == maxattemp)
                {
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine("YOU FAILED!!!");
                    Console.ResetColor();
                    Console.ForegroundColor = ConsoleColor.Yellow;
                    Console.WriteLine($"Correct Number: {secret}");
                    Console.ResetColor();
                }
                else
                {
                    Console.WriteLine("Press Enter to try again");
                    Console.ReadLine();
                }
            }
        }

        static void Main(string[] args)
        {
            bool hello = false;
            while (!hello)
            {
                Console.WriteLine("============================================");
                Console.WriteLine("              Kulot Guesser                  ");
                Console.WriteLine("                [1]. Enter                   ");
                Console.WriteLine("                [2]. Leave                   ");
                Console.WriteLine("=============================================");
                Console.WriteLine("Game Inspired by Marco Secreto");
                Console.Write("Enter: ");
                string input = Console.ReadLine();

                if (input == "1")
                {
                    Console.WriteLine("Welcome!!");
                    hello = true;
                    Number();
                    
                }
                else if (input == "2")
                {
                    Console.WriteLine("GoodBye :( ");
                    hello = true;
                }
                else
                {
                    Console.Clear();
                    Console.WriteLine("Pls Enter a valid selection (e.g. 1 or 2 )");
                    hello = false;
                }


            }
        }
    }
}
